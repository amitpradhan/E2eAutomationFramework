<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Runs individual @Test methods concurrently using 4 threads -->
<suite name="Parallel Methods Suite" parallel="methods" thread-count="4" verbose="1">

    <listeners>
        <listener class-name="com.automation.e2e.listeners.TestListener"/>
    </listeners>

    <test name="UI and DB Method Tests">
        <classes>
            <class name="com.automation.e2e.tests.db.DatabaseIntegrationTest" />
            <class name="com.automation.e2e.tests.e2e.TriLayerE2eWorkflowTest" />
        </classes>
    </test>

</suite>