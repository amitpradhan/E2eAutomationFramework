<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Runs Test Classes concurrently using 2 threads -->
<suite name="Parallel Classes Suite" parallel="classes" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="com.automation.e2e.listeners.TestListener"/>
    </listeners>

    <test name="Multi-Class Execution">
        <classes>
            <class name="com.automation.e2e.tests.db.DatabaseIntegrationTest" />
            <class name="com.automation.e2e.tests.e2e.TriLayerE2eWorkflowTest" />
        </classes>
    </test>

</suite>