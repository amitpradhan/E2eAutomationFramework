<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Database Test Suite" verbose="1" parallel="false">

    <!-- Listener for Extent Reports and logging -->
     <listeners>
        <listener class-name="com.automation.e2e.listeners.TestListener"/>
    </listeners>

    <test name="DB and Data Persistence Tests">
        <!-- Test classes execution -->
        <classes>
            <class name="com.automation.e2e.tests.db.DatabaseIntegrationTest" />
            <class name="com.automation.e2e.tests.e2e.TriLayerE2eWorkflowTest" />
        </classes>
    </test>

</suite>